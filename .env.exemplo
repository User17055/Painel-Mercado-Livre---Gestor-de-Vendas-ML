# Copie para .env (na raiz do projeto) e ajuste. O .env e PESSOAL de cada PC: nunca enviar, nunca versionar.
# Linha vazia ou comentada = vale o padrao (as pastas do proprio projeto).

# --- Modo de uso -------------------------------------------------------------------------------------------------------------
# Uso normal: UM servidor; os usuarios so abrem o endereco dele no navegador (nao precisam deste arquivo).
# No SERVIDOR: 1 = mostra o botao "Atualizar agora" (ele guarda os tokens do ML; refresh token de uso unico).
# 0 = so leitura (padrao seguro, ex.: testar no proprio PC sem tokens).
PAINEL_PERMITE_ATUALIZAR=0

# --- Rede --------------------------------------------------------------------------------------------------------------------
# 127.0.0.1 = so este PC abre o painel. No SERVIDOR: 0.0.0.0 = os usuarios abrem por http://<ip-do-servidor>:8501.
PAINEL_EXPOR=127.0.0.1
PAINEL_PORTA=8501

# --- Pastas deste PC (use / mesmo no Windows; caminho relativo e a partir da raiz do projeto) ----------------------------------
# Dados: vendas_api.db e o registro da atualizacao. Pode ser uma pasta compartilhada (rede, OneDrive, Google Drive) para quem so le.
# ML_DADOS_HOST=./dados
# Parametros e custos (ml_parametros.json, custos_produtos.csv).
# ML_CONFIG_HOST=./analise
# Tokens do ML (so na maquina que atualiza). Ex.: C:/Users/<seu-usuario>/.ml-api
# ML_API_HOST=

# --- App do Mercado Livre (so na maquina que atualiza) ------------------------------------------------------------------------
# ML_CLIENT_ID=
# ML_CLIENT_SECRET=
